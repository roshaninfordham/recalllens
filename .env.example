# Copy to .env.local (gitignored). Never commit real values: this repo is public.

# --- Cognee Cloud (memory) --- https://platform.cognee.ai → API keys
COGNEE_BASE_URL=https://<your-tenant>.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET=personal_spatial_memory

# --- ClawMax (agent orchestration) ---
# Chat API served by ClawMax's dashboard server (./SYSTEM/start.sh)
CLAWMAX_BASE_URL=http://localhost:3001
# Value of SYSTEM/dashboard/.dashboard-token (or leave blank if BYPASS_OAUTH=true locally)
CLAWMAX_DASHBOARD_TOKEN=
CLAWMAX_AGENT_ID=memory-concierge

# --- OpenClaw gateway (fallback agent path + vision via OpenAI-compatible endpoint) ---
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# --- Vision ---
# auto: OpenClaw gateway if configured, else VISION_BASE_URL (any OpenAI-compatible vision endpoint, incl. local Ollama)
VISION_MODE=auto
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# URL the agent's skills curl to reach this app's tool endpoints
RECALLLENS_TOOL_BASE_URL=http://127.0.0.1:3000
