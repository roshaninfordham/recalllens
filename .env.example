# Copy to .env.local (gitignored). Never commit real values: this repo is public.

# --- Cognee Cloud (memory) --- https://platform.cognee.ai → API keys
COGNEE_BASE_URL=https://<your-tenant>.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_DATASET=personal_spatial_memory

# --- Model key (vision + local agent runtime). The hackathon key issued via ClawMax is an OpenAI key. ---
OPENAI_API_KEY=
# Optional overrides
# VISION_MODEL=gpt-4.1
# AGENT_MODEL=gpt-4.1
# VISION_BASE_URL=http://127.0.0.1:11434/v1   # any OpenAI-compatible endpoint, e.g. local Ollama
# VISION_API_KEY=
# AGENT_BASE_URL=
# AGENT_API_KEY=

# --- ClawMax (agent orchestration). Leave CLAWMAX_BASE_URL empty to run the agent locally. ---
# Must be a ClawMax running on this machine: its skills call http://127.0.0.1:3000/api/tools/*.
CLAWMAX_BASE_URL=
CLAWMAX_DASHBOARD_TOKEN=
CLAWMAX_AGENT_ID=memory-concierge
# 1 = send OPENAI_API_KEY with each chat request (for instances that keep model keys browser-local)
CLAWMAX_BYOK_OPENAI=

# --- Optional: vision through the OpenClaw gateway's OpenAI-compatible endpoint ---
# VISION_MODE=auto
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=
